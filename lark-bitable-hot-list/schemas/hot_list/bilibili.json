  "execution_defaults": {
    "collect_mode": "times",
    "collect_times": 1,
    "deduplication_enabled": true,
    "deduplication_field": "bvid",
    "deduplication_source": "bvid",
    "deduplication_strategy": "keepOld",
    "form_data": {
      "pn": 1
    }
  },
  "table_schema_ref": {
    "schema_id": "bilibili_hot_list",
    "schema_file": "../tables/bilibili_hot_list.json"
  }
