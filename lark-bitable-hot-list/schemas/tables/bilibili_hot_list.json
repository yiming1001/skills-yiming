      "label": "发布时间",
      "type": "datetime",
      "field_type": 5,
      "source": "pubdate",
      "transform": "timestamp"
    },
    {
      "key": "duration",
      "label": "时长",
      "type": "text",
      "field_type": 1,
      "source": "duration",
