      "label": "封面图",
      "type": "text",
      "field_type": 1,
      "source": "pic"
    },
    {
      "key": "owner_mid",
      "label": "UP主ID",
      "type": "number",
      "field_type": 2,
      "source": "owner.mid"
    },
    {
      "key": "owner_name",
      "label": "UP主昵称",
      "type": "text",
      "field_type": 1,
      "source": "owner.name"
    },
    {
