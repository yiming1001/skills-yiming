{
  "schema_version": "table-schema.v1",
  "table_schema_id": "bilibili_hot_list",
  "platform": "bilibili",
  "platform_name": "B站",
  "function_type": "hot_list",
  "table_name": "B站热榜",
  "target": "personal_bitable",
